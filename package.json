{
  "name": "codevigil-ai-reviewer",
  "version": "1.0.0",
  "description": "CodeVigil AI - Production-Grade AI Code Reviewer, Security Auditor & Interactive Debugger",
  "type": "module",
  "scripts": {
    "start": "node dev.js",
    "dev": "node dev.js",
    "server": "node server/src/server.js",
    "client": "node client/node_modules/vite/bin/vite.js --port 3000",
    "build": "node client/node_modules/vite/bin/vite.js build --config client/vite.config.js",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "keywords": [
    "ai",
    "code-reviewer",
    "debugger",
    "security-scanner",
    "gemini",
    "monaco-editor",
    "static-analysis",
    "ast"
  ],
  "author": "CodeVigil Team",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}
